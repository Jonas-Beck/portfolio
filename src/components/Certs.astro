---
import type { CollectionEntry } from "astro:content";
import { formatCertDates } from "../lib/certs";
import External from "./icons/External.astro";
import Section from "./Section.astro";

// Takes the entries already sorted: index.astro owns the order. Compact rows,
// not contrib's cards: an exam should not read as weighty as upstream work.
// The rows share one grid, so the abbr column fits the longest abbr and the
// names stay aligned beneath each other.
interface Props {
  certs: CollectionEntry<"certs">[];
}

const { certs } = Astro.props;
---

<Section id="certs">
  <ul class="grid grid-cols-[minmax(5.5rem,max-content)_minmax(0,1fr)] gap-x-4 gap-y-5 max-sm:grid-cols-1">
    {certs.map(({ data }) => {
      const { abbr, name, issuer, url } = data;
      return (
        <li class="col-span-full grid grid-cols-subgrid">
          <span class="text-accent text-lg font-extrabold">{abbr}</span>
          <div>
            <a
              class="text-path text-lg hover:underline"
              href={url}
              target="_blank"
              rel="noopener"
            >
              <External text={name} />
            </a>
            <p class="text-fg-dim mt-1 text-xs">
              {issuer} · {formatCertDates(data)}
            </p>
          </div>
        </li>
      );
    })}
  </ul>
</Section>
