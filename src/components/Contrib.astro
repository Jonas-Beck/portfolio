---
import type { CollectionEntry } from "astro:content";
import { deriveContribState, repoUrl } from "../lib/contrib";
import External from "./icons/External.astro";
import Section from "./Section.astro";

interface Props {
  contribs: CollectionEntry<"contrib">[];
}

const { contribs } = Astro.props;
---

<Section id="contrib">
  <div class="flex flex-col gap-5">
    {contribs.map(({ data }) => {
      const { name, repo, summary, note, image, prs } = data;
      const state = deriveContribState(data);
      return (
        <article
          class:list={[
            "border-edge bg-bg-alt grid grid-cols-[minmax(0,1fr)] border",
            image &&
              "lg:grid-cols-[minmax(0,1fr)_26rem] xl:grid-cols-[minmax(0,1fr)_32rem]",
          ]}
        >
          <div class="flex min-w-0 flex-col p-5 sm:p-7">
            <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1.5">
              <h3 class="text-accent tracking-display text-2xl font-extrabold wrap-anywhere sm:text-3xl">
                {name}
              </h3>
              {/* Green is live state only, and an open pr is not yet live. */}
              <span
                data-contrib-state={state}
                class:list={[
                  "ml-auto text-xs max-sm:ml-0",
                  state === "open" ? "text-fg-dim" : "text-ok",
                ]}
              >
                {state}
              </span>
            </div>
            <p class="text-fg-dim mt-3 max-w-[52ch] text-base">{summary}</p>

            {/* A maintainer contrib may list none: the repo link is its evidence. */}
            {prs.length > 0 && (
              <ul data-prs class="mt-4 flex flex-col gap-1.5 text-sm">
                {prs.map(({ title, url }) => (
                  <li>
                    <a
                      class="text-path wrap-anywhere hover:underline"
                      href={url}
                      target="_blank"
                      rel="noopener"
                    >
                      <External text={title} />
                    </a>
                  </li>
                ))}
              </ul>
            )}

            <div class="mt-auto pt-6">
              <hr class="border-edge border-dashed" />
              <p class="text-fg-dim mt-3.5 text-xs wrap-anywhere">
                <a
                  class="text-path hover:underline"
                  href={repoUrl(repo)}
                  target="_blank"
                  rel="noopener"
                >
                  {repo}
                </a>
                {note && ` · ${note}`}
              </p>
            </div>
          </div>

          {image && (
            <figure class="border-edge bg-bg-soft relative aspect-[16/10] min-w-0 overflow-hidden p-2.5 max-lg:border-t lg:aspect-[2/1] lg:border-l">
              <span class="border-key absolute top-1 left-1 z-2 h-3 w-3 border border-r-0 border-b-0" />
              <span class="border-key absolute top-1 right-1 z-2 h-3 w-3 border border-b-0 border-l-0" />
              <span class="border-key absolute bottom-1 left-1 z-2 h-3 w-3 border border-t-0 border-r-0" />
              <span class="border-key absolute right-1 bottom-1 z-2 h-3 w-3 border border-t-0 border-l-0" />
              <img
                class="block h-full w-full max-w-full object-cover object-left-top"
                src={image}
                alt={`${name} in use`}
                loading="lazy"
                width="687"
                height="581"
              />
              <span class="outline-edge pointer-events-none absolute inset-2.5 outline -outline-offset-1" />
            </figure>
          )}
        </article>
      );
    })}
  </div>
</Section>
