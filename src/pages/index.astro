---
import { getCollection } from "astro:content";
import Contrib from "../components/Contrib.astro";
import Experience from "../components/Experience.astro";
import Whoami from "../components/Whoami.astro";
import Layout from "../layouts/Layout.astro";
import { sortExperience } from "../lib/experience";

const experience = sortExperience(await getCollection("experience"));
// File order is the display order Jonas chose.
const contribs = await getCollection("contrib");
---

<Layout>
  <Whoami />
  <Experience experience={experience} />
  <Contrib contribs={contribs} />
</Layout>
